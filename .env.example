# ==========================================
# TRINAYAA HERBAL E-COMMERCE CONFIGURATION
# ==========================================

# Node & Server Runtime
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://trinayaa.in
NEXT_PUBLIC_APP_URL=https://trinayaa.in

# Cryptographic & Session Secrets (Replace with random 32+ character strings)
SESSION_SECRET=trinayaa_secure_session_key_prod_2026
JWT_SECRET=trinayaa_secure_session_key_prod_2026

# Database Path (Default: SQLite WAL mode on persistent disk)
DATABASE_PATH=./data/trinayaa.db
DATABASE_URL=sqlite:./data/trinayaa.db

# Live/Test Razorpay Payment Gateway Credentials
# Obtain from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_value
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_value

# Optional Legacy Gateway Fallbacks
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Telegram Admin Bot Credentials (Phase 6)
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=placeholder_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=placeholder_telegram_webhook_secret
# Comma-separated list of numerical Telegram User IDs authorized for store management
TELEGRAM_ALLOWED_ADMIN_IDS=123456789,987654321
TELEGRAM_ADMIN_IDS=123456789,987654321

# Optional Outbound Email (SMTP) Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=support@trinayaa.in
# SMTP_PASS=app_specific_password_here
# SMTP_FROM="TRINAYAA Enterprises <support@trinayaa.in>"
