# ==============================================================================
# TRINAYAA ENTERPRISES — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in your production environment and configure with live credentials.
# NEVER commit real credentials, production secrets, or private keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
# Environment mode: 'production' for live deployments, 'development' for local testing
NODE_ENV=production

# Server listening port (default: 3000)
PORT=3000

# Canonical public base URL of the store (e.g., https://trinayaa.com)
PUBLIC_BASE_URL=https://trinayaa.in
NEXT_PUBLIC_APP_URL=https://trinayaa.in

# Cryptographic session & JWT secrets (Generate 64+ char random hex string: openssl rand -hex 32)
SESSION_SECRET=change_this_to_a_secure_random_64_char_secret_string_in_production
JWT_SECRET=change_this_to_a_secure_random_64_char_secret_string_in_production

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (SQLITE / DRIZZLE ORM)
# ------------------------------------------------------------------------------
# Path to SQLite database file (relative or absolute)
DATABASE_PATH=./data/trinayaa.db
DATABASE_URL=file:./data/trinayaa.db

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY (RAZORPAY)
# ------------------------------------------------------------------------------
# Razorpay API credentials (rzp_test_... for sandbox/UAT, rzp_live_... for production)
RAZORPAY_KEY_ID=rzp_live_PLACEHOLDER_KEY_ID
RAZORPAY_KEY_SECRET=PLACEHOLDER_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER_RAZORPAY_WEBHOOK_SECRET

# Fallback alias keys supported by payment router
PAYMENT_GATEWAY_KEY_ID=rzp_live_PLACEHOLDER_KEY_ID
PAYMENT_GATEWAY_KEY_SECRET=PLACEHOLDER_RAZORPAY_KEY_SECRET
PAYMENT_GATEWAY_WEBHOOK_SECRET=PLACEHOLDER_RAZORPAY_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 4. TELEGRAM BOT NOTIFICATIONS & DISPATCH ALERTS
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=0000000000:AA_PLACEHOLDER_BOT_TOKEN_FROM_BOTFATHER

# Secret token for authenticating incoming Telegram webhooks (optional when using polling)
TELEGRAM_WEBHOOK_SECRET=PLACEHOLDER_TELEGRAM_WEBHOOK_SECRET

# Comma-separated list of authorized Admin Telegram Chat IDs for order and enquiry alerts
TELEGRAM_ALLOWED_ADMIN_IDS=1979530961,8877665544
TELEGRAM_ADMIN_IDS=1979530961,8877665544

# ------------------------------------------------------------------------------
# 5. SMS & OTP NOTIFICATIONS (2FACTOR / FAST2SMS)
# ------------------------------------------------------------------------------
# 2Factor SMS Gateway credentials for transactional OTPs
TWOFACTOR_API_KEY=PLACEHOLDER_2FACTOR_API_KEY
TWOFACTOR_TEMPLATE_NAME=TRINAYAA_OTP

# Fast2SMS Gateway fallback credentials
FAST2SMS_API_KEY=PLACEHOLDER_FAST2SMS_API_KEY
FAST2SMS_ROUTE=dlt

# ------------------------------------------------------------------------------
# 6. AI & EXTERNAL INTEGRATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# Hugging Face API key for AI assistant features (optional)
HF_TOKEN=PLACEHOLDER_HF_TOKEN
HUGGINGFACE_API_KEY=PLACEHOLDER_HF_KEY
