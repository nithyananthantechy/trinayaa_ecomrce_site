# Node & Server
NODE_ENV=development
PORT=3000

# Session & Security
SESSION_SECRET=trinayaa_secure_session_key_prod_2026

# Razorpay Payment Gateway Credentials
# Replace with your test/live keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
